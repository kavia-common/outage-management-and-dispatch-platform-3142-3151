        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfJobStatusEventDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/customers/{customerUserId}": {

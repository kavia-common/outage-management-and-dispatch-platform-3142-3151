    "/api/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Search customers by name/email/phone",
        "operationId": "SearchCustomers",
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"

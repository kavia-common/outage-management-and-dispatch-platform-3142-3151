  },
  "components": {
    "schemas": {
      "LocationDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "addressLine1",
          "city",
          "country"
        ],
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          }
        }
      },
      "CustomerDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "OutageDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "locationId",
          "title",
          "severity",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "organizationId": { "type": "string" },
          "reportedByUserId": { "type": "string", "nullable": true },
          "customerUserId": { "type": "string", "nullable": true },
          "locationId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "severity": { "type": "string" },
          "status": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time", "nullable": true },
          "resolvedAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "JobDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "outageId",
          "status",
          "priority",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "organizationId": { "type": "string" },
          "outageId": { "type": "string" },
          "assignedCrewId": { "type": "string", "nullable": true },
          "assignedToUserId": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "priority": { "type": "string" },
          "notes": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "JobStatusEventDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jobId",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "jobId": { "type": "string" },
          "status": { "type": "string" },
          "changedByUserId": { "type": "string", "nullable": true },
          "message": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "OutageUpdateDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outageId",
          "updateType",
          "message",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "outageId": { "type": "string" },
          "updateType": { "type": "string" },
          "message": { "type": "string" },
          "createdByUserId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateOutageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "title",
          "severity",
          "location"
        ],
        "properties": {
          "organizationId": { "type": "string" },
          "reportedByUserId": { "type": "string", "nullable": true },
          "customerUserId": { "type": "string", "nullable": true },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "severity": { "type": "string" },
          "startedAt": { "type": "string", "format": "date-time", "nullable": true },
          "location": { "$ref": "#/components/schemas/LocationDto" }
        }
      },
      "UpdateOutageStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": { "type": "string" },
          "message": { "type": "string", "nullable": true },
          "changedByUserId": { "type": "string", "nullable": true },
          "resolvedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "AddOutageNoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": { "type": "string" },
          "createdByUserId": { "type": "string", "nullable": true }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "outageId",
          "priority"
        ],
        "properties": {
          "organizationId": { "type": "string" },
          "outageId": { "type": "string" },
          "priority": { "type": "string" },
          "notes": { "type": "string", "nullable": true }
        }
      },
      "AssignJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignedCrewId": { "type": "string", "nullable": true },
          "assignedToUserId": { "type": "string", "nullable": true },
          "message": { "type": "string", "nullable": true },
          "changedByUserId": { "type": "string", "nullable": true }
        }
      },
      "UpdateJobStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": { "type": "string" },
          "message": { "type": "string", "nullable": true },
          "changedByUserId": { "type": "string", "nullable": true }
        }
      },
      "PagedResultOfOutageDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "returned"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutageDto"
            }
          },
          "limit": { "type": "integer", "format": "int32" },
          "offset": { "type": "integer", "format": "int32" },
          "returned": { "type": "integer", "format": "int32" }
        }
      },
      "PagedResultOfJobDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "returned"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobDto"
            }
          },
          "limit": { "type": "integer", "format": "int32" },
          "offset": { "type": "integer", "format": "int32" },
          "returned": { "type": "integer", "format": "int32" }
        }
      },
      "PagedResultOfCustomerDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "returned"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerDto"
            }
          },
          "limit": { "type": "integer", "format": "int32" },
          "offset": { "type": "integer", "format": "int32" },
          "returned": { "type": "integer", "format": "int32" }
        }
      },
      "PagedResultOfOutageUpdateDto": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "limit",
          "offset",
          "returned"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutageUpdateDto"
            }
          },
          "limit": { "type": "integer", "format": "int32" },
          "offset": { "type": "integer", "format": "int32" },
          "returned": { "type": "integer", "format": "int32" }
        }
      }
    }
  }
}
